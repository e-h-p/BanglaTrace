# Optional: copy to .env in the repository root. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ENABLE_DEMO_LIBRARY=true
EMBEDDING_DEVICE=cpu
LABSE_REVISION=main
MAX_UPLOAD_MB=10
MAX_SOURCES=30
MAX_SOURCE_SENTENCES=12000
MAX_QUERY_SENTENCES=500
MAX_TEXT_CHARS=500000
MAX_PDF_PAGES=500
MAX_SESSION_MB=100
MAX_SESSIONS=32
MAX_REPORTS=10
MAX_PAIR_CHARS=16000
SESSION_TTL_SECONDS=7200
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Set only behind an authenticated HTTPS reverse proxy; also set COOKIE_SECURE=true.
ALLOW_REMOTE_DEPLOYMENT=false
